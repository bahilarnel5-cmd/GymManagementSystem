{
  "rootDirectory": "frontend",
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "https://gymmanagementsystem-rkav.onrender.com/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
